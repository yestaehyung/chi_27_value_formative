# ── Secrets / env ─────────────────────────────
.env
.env.*
!.env.example

# ── Local SQLite (prod DB lives on the Railway volume) ──
*.db
*.db-wal
*.db-shm

# ── Python ────────────────────────────────────
.venv/
__pycache__/
*.pyc
.pytest_cache/

# ── Node / Next.js ────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# ── Runtime-generated research output (belongs on the volume) ──
backend/exports/

# ── Snapshot/backup files (the live file is canonical; *.db already ignored) ──
*.bak*
*~

# ── Regenerable research artifacts (not needed for the participant-study deploy) ──
backend/data/

# ── Research proposal doc (not deployable code, 6.4MB) ──
*.pdf

# ── ETL intermediates (not loaded at runtime — merged into products.json) ──
backend/seed_naver/category_reclassified.json
backend/seed_naver/fashion_reclassified.json
backend/seed_naver/synthetic_products.json
backend/seed_naver/scenarios_electronics_draft.json
backend/seed_naver/product_descriptions.json
backend/seed_naver/products_naver.json

# ── Logs / OS ─────────────────────────────────
*.log
.DS_Store

# 본실험 전 상품 풀(구 28카테고리) 백업 — 62MB. 로컬 보관만 한다.
# 커밋하면 저장소가 그만큼 커지고 Railway 빌드가 매번 이걸 내려받는다.
# 복원이 필요하면 scripts/archive_nonstudy_categories.py --restore 를 로컬에서 돌린다.
backend/seed_amazon/archive_28cat_*.json
backend/seed_amazon/archive_28cat_*.json.gz
backend/seed_amazon/*.bak-*
backend/seed_amazon/*.pre-profile.bak
seed_amazon_full/
# 영어 전용 46,928개 임베딩 캐시(약 213MB)는 Railway/local volume artifact.
# seed/벡터 manifest는 추적 가능하지만 캐시 본체는 GitHub 단일 파일 한도를 넘는다.
backend/seed_en_v1/product_vectors.json.gz
backend/exports_en_v1/
screenshots/
